# Copie este arquivo para .env e preencha. NUNCA versione o .env.

# Token da API do Escavador (painel do Escavador > API > Tokens)
ESCAVADOR_API_TOKEN=

# CNPJ da ComRio (Comissaria Aérea Rio de Janeiro Ltda) - com ou sem pontuação
COMRIO_CNPJ=

# Limite de requisições por minuto que o programa vai respeitar (o SDK oficial usa 500 como padrão)
ESCAVADOR_MAX_REQ_POR_MIN=60

# Itens por página na busca por envolvido (a API recusa valores fora dos permitidos)
ESCAVADOR_ITENS_POR_PAGINA=100

# Custo em créditos de cada chamada, SE você souber pelo seu contrato/tabela.
# Deixe em branco: o comando "teste" mede o custo real pelo saldo antes/depois.
CUSTO_PAGINA_ENVOLVIDO=
CUSTO_MOVIMENTACOES=
CUSTO_RESUMO_ENVOLVIDO=

# Dias sem movimentação para acender o alerta
DIAS_ALERTA_PARADO=90
